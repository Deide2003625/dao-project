# ══════════════════════════════════════════════════════════════
# .dockerignore — Fichiers exclus du contexte de build Docker
#
# Ces fichiers ne seront jamais copiés dans l'image Docker.
# Réduit la taille du contexte et évite les fuites de secrets.
# ══════════════════════════════════════════════════════════════

# Dépendances — seront réinstallées dans le conteneur
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build Next.js — sera regénéré dans le conteneur
.next/
out/

# Fichiers d'environnement — ne jamais inclure dans l'image
.env
.env.local
.env.production
.env.development
.env.*.local

# Git
.git/
.gitignore
.gitattributes

# Docker
Dockerfile*
docker-compose*
.dockerignore

# Logs
logs/
*.log

# Tests
__tests__/
*.test.js
*.test.ts
*.spec.js
*.spec.ts
coverage/
.nyc_output/

# IDE et outils
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Documentation
README*
CHANGELOG*
docs/

# CI/CD
.github/
.gitlab-ci.yml
.circleci/

# Données locales
uploads/
backups/