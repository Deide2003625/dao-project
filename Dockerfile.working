# ── Stage 1 : Installation des dépendances ───────────────────
FROM node:20-alpine AS deps

RUN apk add --no-cache libc6-compat
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci && npm cache clean --force


# ── Stage 2 : Build ──────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV DB_HOST=mysql
ENV DB_PORT=3306
ENV DB_USER=build_placeholder
ENV DB_PASSWORD=build_placeholder
ENV DB_NAME=dao
ENV NEXTAUTH_URL=http://localhost:3000
ENV NEXTAUTH_SECRET=build_placeholder_secret_minimum_32_characters_xx

COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN npm run build


# ── Stage 3 : Runner minimal ──────────────────────────────────
FROM node:20-alpine AS runner

ARG PORT=3000
ENV PORT=$PORT
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

RUN apk add --no-cache curl

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 --ingroup nodejs nextjs

# Standalone inclut uniquement les fichiers nécessaires
# node_modules complet non nécessaire — économie de 500MB+
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

RUN mkdir -p /app/uploads /app/logs && \
    chown -R nextjs:nodejs /app/uploads /app/logs

USER nextjs

EXPOSE $PORT

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=40s \
  CMD curl -f http://localhost:$PORT/api/health || exit 1

# standalone génère un server.js autonome — plus léger que npm start
CMD ["sh", "-c", "PORT=$PORT HOSTNAME=0.0.0.0 node server.js"]