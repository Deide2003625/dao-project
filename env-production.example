# ══════════════════════════════════════════════════════════════
# CONFIGURATION DU PROJET — DAO
#
# Copier ce fichier en .env et adapter les valeurs :
#   cp env-production.example .env
#
# IMPORTANT : Ne jamais commiter le fichier .env dans Git.
#             Seul .env.example doit être versionné.
#
# Générer des secrets sécurisés :
#   openssl rand -base64 32
#   ou
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ══════════════════════════════════════════════════════════════


# ── PORTS HOST ────────────────────────────────────────────────
# Modifier ces valeurs si les ports par défaut sont déjà utilisés
# sur votre machine. L'application utilise le même port externe et
# interne dans Docker (APP_PORT). Exemple : 4000:4000.
# Vérifier les ports occupés avec : sudo ss -tlnp

APP_PORT=3000               # Application Next.js   → http://localhost:3000
MYSQL_PORT=3306             # Base de données MySQL  → localhost:3306


# ── RÉSEAU DOCKER ─────────────────────────────────────────────
# Modifier si le subnet entre en conflit avec un réseau existant.
# Vérifier les conflits avec :
#   docker network inspect $(docker network ls -q) \
#     --format '{{.Name}} : {{range .IPAM.Config}}{{.Subnet}}{{end}}'

DOCKER_SUBNET=172.25.0.0/16
DOCKER_GATEWAY=172.25.0.1


# ── BASE DE DONNÉES MySQL ─────────────────────────────────────
# SÉCURITÉ : Modifier DB_PASSWORD et MYSQL_ROOT_PASSWORD
#            avant tout déploiement en production

DB_HOST=mysql
DB_PORT=3306
DB_NAME=dao
DB_USER=dao_user
DB_PASSWORD=dao_secure_password_2024                    # A CHANGER

MYSQL_ROOT_PASSWORD=root_secure_password_2024           # A CHANGER
MYSQL_DATABASE=dao
MYSQL_USER=dao_user
MYSQL_PASSWORD=dao_secure_password_2024                 # A CHANGER


# ── APPLICATION Next.js ───────────────────────────────────────
NODE_ENV=production
APP_NAME=DAO Project
APP_URL=http://localhost:3000
APP_VERSION=1.0.0

# SÉCURITÉ : Générer avec : openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGEZ_CECI_PAR_UNE_VRAIE_CLE_SECRETE_DE_32_CARACTERES_MINIMUM  # A CHANGER

# SÉCURITÉ : Générer avec : openssl rand -base64 32
JWT_SECRET=CHANGEZ_CECI_PAR_UNE_VRAIE_CLE_JWT_DE_32_CARACTERES_MINIMUM           # A CHANGER


# ── EMAIL (SMTP) ──────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=votre_email@gmail.com
EMAIL_PASSWORD=votre_mot_de_passe_application_gmail     # A CHANGER
EMAIL_FROM=noreply@dao-project.com
EMAIL_FROM_NAME=DAO Project


# ── UPLOADS ───────────────────────────────────────────────────
MAX_FILE_SIZE=10485760              # 10 Mo en octets
UPLOAD_DIR=/app/uploads


# ── LOGS ──────────────────────────────────────────────────────
LOG_LEVEL=info                      # Valeurs : debug, info, warn, error
LOG_FILE=/app/logs/app.log


# ── MONITORING ────────────────────────────────────────────────
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true


# ══════════════════════════════════════════════════════════════
# CHECKLIST SECURITE AVANT DEPLOIEMENT
# ══════════════════════════════════════════════════════════════
# [ ] NEXTAUTH_SECRET     genere avec : openssl rand -base64 32
# [ ] JWT_SECRET          genere avec : openssl rand -base64 32
# [ ] DB_PASSWORD         mot de passe fort (min. 16 caracteres)
# [ ] MYSQL_ROOT_PASSWORD mot de passe fort (min. 16 caracteres)
# [ ] EMAIL_PASSWORD      mot de passe d application Gmail
# [ ] APP_URL             URL reelle de production (pas localhost)
# [ ] NEXTAUTH_URL        URL reelle de production (pas localhost)
# [ ] .env ajoute au .gitignore
# ══════════════════════════════════════════════════════════════
