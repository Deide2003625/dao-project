# ══════════════════════════════════════════════════════════════
# .env — Ne jamais commiter ce fichier
# ══════════════════════════════════════════════════════════════

# Nom du projet Docker
COMPOSE_PROJECT_NAME=

# ── Application ───────────────────────────────────────────────
APP_PORT=

# ── Base de données ───────────────────────────────────────────
DB_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
# Générer : openssl rand -base64 24
MYSQL_PASSWORD=
# Générer : openssl rand -base64 24
MYSQL_ROOT_PASSWORD=

# ── NextAuth ──────────────────────────────────────────────────
NEXTAUTH_URL=
# Générer : openssl rand -base64 32
NEXTAUTH_SECRET=

# ── Email ─────────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=
EMAIL_SENDER=
EMAIL_SENDER_NAME=
EMAIL_RECEIVER=
EMAIL_RECEIVER_NAME=